{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "workspace": {
    "enableReindex": true,
    "reindexDuration": 20000,
    "encoding": "utf-8",
    "ignoreDir": [
      ".git",
      ".venv"
    ],
    "library": [
      "$HYPRLAND_STUBS_PATH"
    ],
    "moduleMap": []
  },
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua"
    ]
  },
  "diagnostics": {
    "globals": [
      "hl"
    ]
  },
  "strict": {
    "arrayIndex": true,
    "docBaseConstMatchBaseType": true,
    "metaOverrideFileDefine": true,
    "requirePath": true
  }
}
